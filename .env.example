# === Telegram / dispatcher ===
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
IS_PRIMARY_DISPATCHER=true
SNAPSHOT_MAX_AGE_SEC=300

# === Notification/alert noise mitigation (see NOTIFIKASI_MITIGASI_REPORT.md) ===
# Cooldown per (coin, arah naik/turun) untuk BIG MOVE ALERT
BIG_MOVE_COOLDOWN_SEC=7200
# Jika alert yang lolos filter dalam satu siklus flush (~60s) >= angka ini,
# gabungkan jadi satu pesan ringkasan alih-alih kirim satu per satu
ALERT_DIGEST_THRESHOLD=5
# Batas atas total alert noise (di luar laporan terjadwal & sinyal trading resmi)
# yang dikirim ke chat per jam; sisanya dirangkum jadi satu baris ringkasan
MAX_ALERTS_PER_HOUR=15
# Cooldown dispatch Telegram untuk shadow_e3 (riset) per (coin, setup, side);
# lihat SHADOW_SIGNAL_SPAM_REPORT.md. Default 4 jam.
SHADOW_SIGNAL_COOLDOWN_SEC=14400

# === LLM & search (set values locally; never commit real secrets) ===
OPENAI_API_KEY=
SERPER_API_KEY=

# === Database (PostgreSQL for dashboard chat — api/server.py) ===
DB_PASSWORD=

# === Macro (FRED — optional, used by macro_monitor) ===
FRED_API_KEY=

# === Macro calendar (FMP — optional; rule-based fallback jika kosong) ===
# Gratis ~250 call/hari: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=
# FMP dipanggil hanya kalau flag ini true DAN FMP_API_KEY terisi. Default
# false: FMP_API_KEY yang ada saat ini mengembalikan HTTP 403 terus-menerus
# (lihat BERITA_MITIGASI_REPORT.md) — set true lagi setelah key diperbarui.
FMP_CALENDAR_ENABLED=false
# Override TTL cache kalender (detik); default 3600
# ECONOMIC_CALENDAR_CACHE_SEC=3600

# === Institutional data (ETF flow, liquidation, BTC netflow) ===
# Daftar akun gratis dulu di masing-masing situs -- key TIDAK bisa didaftarkan
# atas nama user oleh siapa pun selain user sendiri.
# SoSoValue (utama -- ETF flow, free Demo API tier, ~20 req/menit):
# https://sosovalue.com/developer
SOSOVALUE_API_KEY=
# Koreksi (lihat INSTITUTIONAL_DATA_REPORT.md, revisi): CoinGlass TIDAK punya
# free tier sama sekali -- plan termurah ("Hobbyist") $29/bln, diverifikasi
# langsung ke coinglass.com/pricing. Tidak lagi dipakai untuk ETF flow (lihat
# SoSoValue di atas + fallback scraping Farside Investors, otomatis, tanpa
# key). Isi HANYA kalau kamu memutuskan upgrade berbayar untuk mengaktifkan
# Liquidation 24h (opsional, tidak wajib untuk fitur lain):
# https://www.coinglass.com/pricing
COINGLASS_API_KEY=
# BTC exchange netflow: CoinGlass free tier TIDAK mencakup endpoint ini (butuh
# plan Startup+, di atas Hobbyist). Scraping fallback (requests+BeautifulSoup,
# bukan headless browser) tersedia tapi nonaktif default karena kandidat situs
# yang diriset butuh render JS untuk menampilkan angkanya -- lihat
# INSTITUTIONAL_DATA_REPORT.md.
BTC_NETFLOW_SCRAPE_ENABLED=false
# Override TTL cache masing-masing (detik); default 3600/1800/3600
# ETF_FLOW_CACHE_SEC=3600
# LIQUIDATION_CACHE_SEC=1800
# BTC_NETFLOW_CACHE_SEC=3600

# === User config (balance via /set_balance — opsional) ===
# USER_CONFIG_DB=data/user_config.db

# === Dashboard API ===
ALIZA_DASHBOARD_PORT=8001

# === Trading / snapshot guards ===
TRADING_MODE=
CB_THRESHOLD=
CB_HEARTBEAT_EVERY=

# === Position sizing (Fase 1 — optional; 0 = disabled) ===
ACCOUNT_BALANCE=0
RISK_PER_TRADE=0.02
MAX_ALLOCATION_PER_TRADE=0.30
MAX_TOTAL_RISK=0.06

# === Learning loop (confidence_adjuster) — optional; default berlaku tanpa di-set ===
# Ambang minimum outcome (WIN+LOSS) per setup sebelum confidence_adjuster
# menggeser confidence dari baseline. Di bawah ambang ini, penyesuaian
# dilewati (dianggap belum cukup data). Default 10.
# LEARNING_MIN_SAMPLES=10

# === Binance balance auto-sync (/set_balance auto) ===
# Permission API key: Enable Reading (cukup untuk GET /api/v3/account)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_API_BASE=https://api.binance.com
BINANCE_BALANCE_CACHE_SEC=300

# === Investing.com calendar (backup jika FMP kosong; rate limit ketat) ===
# INVESTING_CALENDAR_CACHE_SEC=3600
# INVESTING_MIN_FETCH_INTERVAL_SEC=3600

# === Auth (api/auth.py — optional override) ===
JWT_SECRET=
