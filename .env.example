# === Telegram / dispatcher ===
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
IS_PRIMARY_DISPATCHER=true
SNAPSHOT_MAX_AGE_SEC=300

# === Notification/alert noise mitigation (see NOTIFIKASI_MITIGASI_REPORT.md) ===
# Cooldown per (coin, arah naik/turun) untuk BIG MOVE ALERT
BIG_MOVE_COOLDOWN_SEC=7200
# Jika alert yang lolos filter dalam satu siklus flush (~60s) >= angka ini,
# gabungkan jadi satu pesan ringkasan alih-alih kirim satu per satu
ALERT_DIGEST_THRESHOLD=5
# Batas atas total alert noise (di luar laporan terjadwal & sinyal trading resmi)
# yang dikirim ke chat per jam; sisanya dirangkum jadi satu baris ringkasan
MAX_ALERTS_PER_HOUR=15

# === LLM & search (set values locally; never commit real secrets) ===
OPENAI_API_KEY=
SERPER_API_KEY=

# === Database (PostgreSQL for dashboard chat — api/server.py) ===
DB_PASSWORD=

# === Macro (FRED — optional, used by macro_monitor) ===
FRED_API_KEY=

# === Macro calendar (FMP — optional; rule-based fallback jika kosong) ===
# Gratis ~250 call/hari: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=
# Override TTL cache kalender (detik); default 3600
# ECONOMIC_CALENDAR_CACHE_SEC=3600

# === User config (balance via /set_balance — opsional) ===
# USER_CONFIG_DB=data/user_config.db

# === Dashboard API ===
ALIZA_DASHBOARD_PORT=8001

# === Trading / snapshot guards ===
TRADING_MODE=
CB_THRESHOLD=
CB_HEARTBEAT_EVERY=

# === Position sizing (Fase 1 — optional; 0 = disabled) ===
ACCOUNT_BALANCE=0
RISK_PER_TRADE=0.02
MAX_ALLOCATION_PER_TRADE=0.30
MAX_TOTAL_RISK=0.06

# === Binance balance auto-sync (/set_balance auto) ===
# Permission API key: Enable Reading (cukup untuk GET /api/v3/account)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_API_BASE=https://api.binance.com
BINANCE_BALANCE_CACHE_SEC=300

# === Investing.com calendar (backup jika FMP kosong; rate limit ketat) ===
# INVESTING_CALENDAR_CACHE_SEC=3600
# INVESTING_MIN_FETCH_INTERVAL_SEC=3600

# === Auth (api/auth.py — optional override) ===
JWT_SECRET=
