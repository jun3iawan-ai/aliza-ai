    return f"${v:,.2f}"


async def near_support_checker(context: ContextTypes.DEFAULT_TYPE):
    """Cek harga dekat support (≤1%); cooldown 4 jam per (coin, near_support)."""
    try:
        snapshot = get_market_snapshot()
